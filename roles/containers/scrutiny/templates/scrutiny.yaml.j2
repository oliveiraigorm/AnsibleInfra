version: 1

web:
  listen:
    port: 8080
    host: 0.0.0.0
    basepath: /scrutiny

notify:
  urls:
    # '#' must be URL-encoded as %23, otherwise shoutrrr treats it as a URL
    # fragment and fires two pushes (empty target -> personal, plus the channel).
    - "pushbullet://{{ pushbullet_key }}/%23scrutiny"